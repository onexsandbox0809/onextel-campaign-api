# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used to sign login JWTs / dashboard session cookies. Generate a random 32+ char string.
JWT_SECRET=replace_with_a_long_random_secret

# Optional: shared secret that external systems must send in the
# "x-api-key" header when POSTing to the keyword APIs. Leave blank to disable.
INBOUND_API_KEY=replace_with_a_long_random_secret_for_inbound_apis
